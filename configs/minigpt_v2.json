{
  "model": {
    "block_size": 192,
    "n_embd": 384,
    "n_head": 6,
    "n_layer": 6,
    "dropout": 0.1,
    "norm_type": "layernorm",
    "ffn_type": "swiglu",
    "ffn_hidden_dim": null,
    "position_encoding": "rope",
    "rope_base": 10000.0
  },
  "training": {
    "batch_size": 32,
    "max_epochs": 10,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "scheduler": "constant",
    "warmup_steps": 200,
    "min_lr": 3e-05,
    "log_every": 50,
    "max_steps": 5000,
    "tensorboard": true,
    "deterministic": true
  },
  "data": {
    "train": "data/train.txt",
    "val": "data/val.txt",
    "test": null,
    "vocab": "data/vocab.json"
  },
  "seed": 42,
  "generation": {
    "form": "wujue",
    "max_new_tokens": 80,
    "temperature": 0.8,
    "top_k": 20,
    "top_p": 0.9,
    "repetition_penalty": 1.1,
    "no_repeat_ngram_size": 0
  }
}
